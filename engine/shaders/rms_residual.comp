#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 128) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { float x[]; };
layout(set = 0, binding = 1, std430) readonly buffer Weights { float weight[]; };
layout(set = 0, binding = 2, std430) buffer Output { float y[]; };
layout(push_constant) uniform Params { uint count; uint residual; uint eps_bits; uint unused; } p;
shared float scale;
#ifdef RMS_PARALLEL
shared float partial[128];
#endif
#include "half_round.glsl"

void main() {
    uint tid = gl_LocalInvocationID.x;
#ifdef RMS_PARALLEL
    // Strided loads are coalesced. Keep FP32 products/adds and the existing
    // FP16 boundary; only the reduction order differs from the serial path.
    precise float sum = 0.0;
    for (uint i = tid; i < p.count; i += 128u) {
        precise float product = x[i] * x[i];
        sum = sum + product;
    }
    partial[tid] = sum;
    barrier();
    for (uint stride = 64u; stride > 0u; stride /= 2u) {
        if (tid < stride) partial[tid] = partial[tid] + partial[tid + stride];
        barrier();
    }
    if (tid == 0u)
        scale = 1.0 / sqrt(partial[0] / float(p.count) + uintBitsToFloat(p.eps_bits));
#else
    if (tid == 0u) {
        precise float sum = 0.0;
        for (uint i = 0u; i < p.count; ++i) {
            precise float value = x[i];
            precise float product = value * value;
            sum = sum + product;
        }
        scale = 1.0 / sqrt(sum / float(p.count) + uintBitsToFloat(p.eps_bits));
    }
#endif
    barrier();
    for (uint i = tid; i < p.count; i += 128u) {
        precise float normalized = halfRound(x[i] * scale * halfRound(weight[i]));
        y[i] = p.residual == 0u ? normalized : y[i] + normalized;
    }
}
