#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=128) in;
layout(set=0,binding=0,std430) readonly buffer Gate { float gate[]; };
layout(set=0,binding=1,std430) readonly buffer Up { float up[]; };
layout(set=0,binding=2,std430) writeonly buffer Output { float y[]; };
layout(push_constant) uniform Params { uint size; uint unused1; uint unused2; uint unused3; } p;
#include "half_round.glsl"
void main() {
    uint i=gl_GlobalInvocationID.x;
    if (i >= p.size) return;
    precise float activated = gate[i] / (1.0 + exp(-gate[i]));
    y[i] = halfRound(activated * up[i]);
}
