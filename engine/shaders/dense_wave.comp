#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// One subgroup owns one output row. No LDS or workgroup barrier is needed.
// Host dispatches only hidden-size 2048 matrices and uses the fixed pipeline
// subgroup size to calculate output rows/workgroup. Tail subgroups participate
// in the reduction with zero, so subgroup operations stay converged.
layout(local_size_x = 128) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { float x[]; };
layout(set = 0, binding = 1, std430) readonly buffer Weights { uint packed[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Output { float y[]; };
layout(push_constant) uniform Params { uint rows; uint cols; uint dtype; uint unused; } p;
void main() {
    uint row = gl_WorkGroupID.x * gl_NumSubgroups + gl_SubgroupID;
    float acc = 0.0;
    if (row < p.cols) {
        for (uint pair = gl_SubgroupInvocationID; pair < 1024u; pair += gl_SubgroupSize) {
            uint word = packed[row * 1024u + pair];
            vec2 w = p.dtype == 0u ? unpackHalf2x16(word)
                : vec2(uintBitsToFloat((word & 65535u) << 16u), uintBitsToFloat(word & 0xffff0000u));
            acc = fma(x[pair * 2u], w.x, acc);
            acc = fma(x[pair * 2u + 1u], w.y, acc);
        }
    }
    float sum = subgroupAdd(acc);
    if (subgroupElect() && row < p.cols) y[row] = sum;
}
