#version 450
layout(local_size_x = 128) in;
layout(set=0,binding=0,std430) readonly buffer Input { float x[]; };
layout(set=0,binding=2,std430) writeonly buffer Output { float y[]; };
layout(push_constant) uniform Params { uint count; uint unused0; uint unused1; uint unused2; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < p.count) y[i] = x[i];
}
